tun_forward_enable() {
  tun_forward_disable
  sleep 1
  echo 1 > /proc/sys/net/ipv4/ip_forward
  
  [ "$(cat /proc/sys/net/ipv4/conf/default/rp_filter)" == "1" ] && \
  echo 2 > /proc/sys/net/ipv4/conf/default/rp_filter
  
  [ "$(cat /proc/sys/net/ipv4/conf/all/rp_filter)" == "1" ] && \
  echo 2 > /proc/sys/net/ipv4/conf/all/rp_filter
  
  ## echo 0 > /dev/ip_forward_stub
  ## chown $(stat -c '%u:%g' /data/misc/net/rt_tables) /dev/ip_forward_stub
  ## chcon $(stat -Z -c '%C' /data/misc/net/rt_tables) /dev/ip_forward_stub
  ## mount -o bind /dev/ip_forward_stub /proc/sys/net/ipv4/ip_forward

  # create_tun_link
  
  # probe_tun_index will not find route table index for sing-box's tun,
  # therefore, tun_forward_ip_rules will not get executed when core is sing-box
  # tun_forward_ip_rules is probably for clash only
  
  # as sing-box's tun have no such table in /data/misc/net/rt_tables
  # it's kernel link route is in table main; and its routes are in table 2022;
  # it does not have a traditional table containing kernel link and rest of the routes in /data/misc/net/rt_tables
  probe_tun_index && tun_forward_ip_rules "add"
  probe_tun_device && tun_forward_iptables_rules "-I" && sing_tun_ip_rules "add" && log Info "tun hotspot support is enabled."
  return 0
}

tun_forward_disable() {
  {
    # tun_forward_ip_rules "del"
    sing_tun_ip_rules "del"
    tun_forward_ip_rules_del
    tun_forward_iptables_rules "-D"
  } >> /dev/null 2>&1
  log Warn "tun hotspot support is disabled."
}





case "$1" in
  start)
    if display_bin_status || start_service ; then
      tun_forward_enable
    fi
    ;;
  stop)
    stop_service
    tun_forward_disable
    ;;
  restart)
    stop_service
    sleep 2
    start_service
    ;;
  pause)
    pause_service
    ;;
  resume)
    resume_service
    ;;
  status)
    display_bin_status
    ;;
  *)
    log Error "$0 $1 usage: $0 {start|stop|restart|status}"
    ;;
esac
