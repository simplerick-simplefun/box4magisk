# !ALERT!: assuming proxy tun is already started, and it has added its own ip rules and ip route table
# At the current code state, we are using:
# 1. always using the tun ip table created by the proxy tun
# 2. when blacklist/whitelist is not set, using the tun ip rule created by the proxy tun
add_tun_rules() {
  if ! check_pid_status 'running'; then
    log Error "add_tun_rules: ${bin_name} service not running, function failed."
    return 1
  fi
  
  # set the variables; check/validate options
  local skip_tun_rule_index=$(( sys_rule_index - 1 ))

  # find and record the tun ip rule starting index
  # *for ${tun_rule_index}, it's ok if no ip rule is added by the proxy tun
  local rule_idx="$(ip rule show | head -n 1 | awk -F: '{print $1}')"
  if [[ "${rule_idx}" != "" && "${rule_idx}" != "0" ]]; then
    tun_rule_index="${rule_idx}"
    sed -i "s/^tun_rule_index=.*/tun_rule_index=\"${tun_rule_index}\"/" ${scripts_dir}/box.config
  fi

  my_rule_index=$(( tun_rule_index - 1000 ))
  sed -i "s/^my_rule_index=.*/my_rule_index=\"${my_rule_index}\"/" ${scripts_dir}/box.config
  
  # !ipv4 only! enable tun forward for hotspot (in ipv4)
  ip rule add prio ${my_rule_index} not fwmark ${mark_id} lookup main
  ip rule add prio $(( my_rule_index + 1 )) from all iif ${tun_device} lookup main suppress_prefixlength 0
  
  # !ipv6 only! disable tun if ipv6 not available
  if ! "$(network_has_ipv6)" ; then
    ip -6 rule add priority $(( my_rule_index - 1 )) from all unreachable
  fi
  
  # DNS modifications
  ## mark all udp/53 (iptables) and route those to tun in "ip rule"
  iptables_cmd -t mangle -N DNS_TO_TUN
  iptables_cmd -t mangle -A OUTPUT -p udp --dport 53 -j DNS_TO_TUN
  ip_cmd rule add prio $(( my_rule_index + 10 )) fwmark ${mark_id} lookup ${tun_table_index}
  
  ## save the original system dns setting, change the new setting to private_dns_mode:off
  local orig_dns_mode
  orig_dns_mode=$(settings get global private_dns_mode)
  sed -i "s/^system_dns_mode=.*/system_dns_mode=\"${orig_dns_mode}\"/" ${scripts_dir}/box.config
  settings put global private_dns_mode off
  
  
  # add blacklist/whitelist apps for tun in ip rule
  ## prepare uid arrays
  boxuserlist_apps_uids=()
  sys_proxy_apps_uids=()
  sys_noneproxy_apps_uids=()

  # exclude system apps from tun in ip rule; not excluding google apps and default download app
  # should exclude for Chinese OEMs' ROMs, should not exclude for international OEMs' ROMs
  
  if [[ "${proxy_mode}" == "blacklist" || "${proxy_mode}" == "whitelist" ]]; then
    ## prepare ${boxuserlist_apps_uids}
    local selector=''
    for pkgName in "${ruled_packages_list[@]}"; do
      selector="${selector}|${pkgName}"
    done
    selector="${selector:1}"
    
    while read user_rule_app_uid; do
      boxuserlist_apps_uids+=("${user_rule_app_uid}")
    done <<< "$(pm list packages -U | awk -F'[: ]' '{print $2, $4}' | grep -E "${selector}" | sort -k2 -n | cut -d ' ' -f2)"
    
    #### more than one apps shares same uid as "com.android.providers.downloads"
    #### therefore, for default download app, add its pkgUID to selector
    local all_sys_apps
    all_sys_apps="$(pm list packages -s -U | awk -F'[: ]' '{print $2, $4}')"
    selector="$(echo "${all_sys_apps}" | grep 'com.android.providers.downloads' | cut -d ' ' -f2)"
    selector="${selector}|com\.android\.shell|com\.google\.android\.|com\.android\.vending"
    
    ## prepare ${sys_proxy_apps_uids}
    if [[ "${proxy_mode}" == "whitelist" ]]; then
      while read -r sys_proxy_app; do
        sys_proxy_apps_uids+=("${sys_proxy_app}")
      done <<< "$(pm list packages -s -U | awk -F'[: ]' '{print $2, $4}' | grep -E "${selector}" | sort -k2 -n | cut -d ' ' -f2)"
    fi
    #### adding root to the proxy whitelist. for magisk/ksu/apatch core-updating/module-downloading.
    sys_proxy_apps_uids=(0 ${sys_proxy_apps_uids[@]})
    
    ## prepare ${sys_noneproxy_apps_uids}
    if [[ "${proxy_mode}" == "blacklist" && "${blacklist_exclude_systemapps}" == "true" ]]; then
      while read -r sys_noneproxy_app; do
        sys_noneproxy_apps_uids+=($sys_noneproxy_app)
      done <<< "$(echo "${all_sys_apps}" | grep -v -E "${selector}" | sort -k2 -n | cut -d ' ' -f2)"
    fi

    #### add skip ip rule
    ip_cmd rule add prio ${skip_tun_rule_index} from all nop
  fi
  
  # for blacklist,
  ### if ${blacklist_exclude_systemapps} is false, exclude uid's from ${boxuserlist_apps_uids},
  ### if ${blacklist_exclude_systemapps} is true, additionally exclude uid's from all system apps, except always-proxy-system-apps(google apps and others)
  if [[ "${proxy_mode}" == "blacklist" ]]; then
    blacklist_apps_uids=()
    if [[ "${blacklist_exclude_systemapps}" == "true" ]]; then
      blacklist_apps_uids=($(sorteduid_array_addition "$(echo "${boxuserlist_apps_uids[@]}")" "$(echo "${sys_noneproxy_apps_uids[@]}")"))
    else
      blacklist_apps_uids=($(sorteduid_array_addition "$(echo "${boxuserlist_apps_uids[@]}")" ""))
    fi
    
    for package_uid in "${blacklist_apps_uids[@]}"; do
      # example: ip rule add prio 8020 from all uidrange 2000:2000 goto 9010
      ip_cmd rule add prio $(( my_rule_index + 20 )) from all uidrange ${package_uid}-${package_uid} goto ${skip_tun_rule_index}
      iptables_cmd -t mangle -A DNS_TO_TUN -m owner --uid-owner ${package_uid} -j RETURN
    done
    
    ip_cmd rule add prio $(( my_rule_index + 30 )) add from all lookup ${tun_table_index}
    iptables_cmd -t mangle -A DNS_TO_TUN -j MARK --set-mark ${mark_id}
  # for whitelist, select from all the apps(system+user), and include always-proxy-system-apps(google apps and others), and make sure they are not duplicated
  elif [[ "${proxy_mode}" == "whitelist" ]]; then
    white_apps_uids=($(sorteduid_array_addition "$(echo "${boxuserlist_apps_uids[@]}")" "$(echo "${sys_proxy_apps_uids[@]}")"))
    
    for package_uid in "${white_apps_uids[@]}"; do
      # example: ip rule add prio 8020 from all uidrange 2000:2000 lookup 2022
      ip_cmd rule add prio $(( my_rule_index + 20 )) from all uidrange ${package_uid}-${package_uid} lookup ${tun_table_index}
      iptables_cmd -t mangle -A DNS_TO_TUN -m owner --uid-owner ${package_uid} -j MARK --set-mark ${mark_id}
    done
    
    ip_cmd rule add prio $(( my_rule_index + 30 )) from all goto ${skip_tun_rule_index}
    ip_cmd rule add prio $(( my_rule_index + 30 )) not from all goto ${skip_tun_rule_index}
    iptables_cmd -t mangle -A DNS_TO_TUN -j RETURN
  fi
}

# DONE: (priority: high)
del_tun_rules() {
  {
    # DNS modifications
    ## remove mark all udp/53 (iptables) to route those to tun in "ip rule"
    iptables_cmd -t mangle -F DNS_TO_TUN
    iptables_cmd -t mangle -D OUTPUT -j DNS_TO_TUN
    iptables_cmd -t mangle -X DNS_TO_TUN

    # considering ip rules >0 <10000 to be manually added by tun proxy
    rule_filter='$1+0 > 0 && $1+0 < '"${sys_rule_index}"' {print $1}'
    ip rule show | awk -F: "${rule_filter}" | while read -r priority; do
      ip rule del prio $priority
    done
    ip -6 rule show | awk -F: "${rule_filter}" | while read -r priority; do
      ip -6 rule del prio $priority
    done
  } >> /dev/null 2>&1
  
  ## revert to the saved original system dns setting
  settings put global private_dns_mode ${system_dns_mode}
}

