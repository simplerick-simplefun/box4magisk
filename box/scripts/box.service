pause_service() {
  check_pid_status 'running'
  if [ ! $? -eq 0 ]; then
    log Error "pause_service: ${bin_name} service not running, pausing failed."
    return 1
  fi
  
  # DNS modifications
  ## revert to the saved original system dns setting
  settings put global private_dns_mode ${system_dns_mode}
  ## remove mark all udp/53 (iptables) to route those to tun in "ip rule"
  iptables_cmd -t mangle -D OUTPUT -p udp --dport 53 -j DNS_TO_TUN >> /dev/null 2>&1
  
  local skip_tun_rule_index=$(( sys_rule_index - 1 ))
  ip_cmd rule add prio $((my_rule_index - 1)) from all goto ${skip_tun_rule_index}
  ip_cmd rule add prio $((my_rule_index - 1)) not from all goto ${skip_tun_rule_index}
  
  # ${bin_pid} has value assigned in check_pid_status
  kill -SIGSTOP ${bin_pid}
}

resume_service() {
  check_pid_status 'paused'
  if [ ! $? -eq 0 ]; then
    log Error "resume_service: ${bin_name} service not paused, resuming failed."
    return 1
  fi
  
  # ${bin_pid} has value assigned in check_pid_status
  kill -SIGCONT ${bin_pid}
  
  local skip_tun_rule_index=$(( sys_rule_index - 1 ))
  ip_cmd rule del prio $((my_rule_index - 1)) from all goto ${skip_tun_rule_index}
  ip_cmd rule del prio $((my_rule_index - 1)) not from all goto ${skip_tun_rule_index}
  
  # DNS modifications
  ## restore mark all udp/53 (iptables) to route those to tun in "ip rule"
  iptables_cmd -t mangle -A OUTPUT -p udp --dport 53 -j DNS_TO_TUN >> /dev/null 2>&1
  ## resume to private_dns_mode:off
  settings put global private_dns_mode off
}

convert_to_ranges()
{
  result=''
  
  start=0
  end=0
  
  while read -r num; do
    if (( end == num - 1 )); then
      ((end++))
    elif (( num > end )); then
      result="${result}${start}-${end}\n"
      start=${num}
      end=${num}
    fi
  done <<< "$1"
  
  result="${result}${start}-${end}"
  
  echo -e "${result}"
}

sorteduid_array_subtraction() {
  arr1=($1)
  arr2=($2)
  
  local result_arr=()

  local arr2_index=0
  local arr2_size=${#arr2[@]}
        
  for arr1_item in "${arr1[@]}"; do
    if (( arr2_index == arr2_size )); then
      result_arr+=("${arr1_item}")
    else
      while (( arr1_item > arr2[arr2_index] && arr2_index < arr2_size )); do
        ((arr2_index++))
      done
      
      if (( arr2_index == arr2_size )); then
        result_arr+=("${arr1_item}")
        continue
      fi
            
      if (( arr1_item < arr2[arr2_index] )); then
        result_arr+=("${arr1_item}")
      elif (( arr1_item == arr2[arr2_index] )); then
        ((arr2_index++))
      fi
    fi
  done
  
  echo "${result_arr[@]}"
}

sorteduid_array_addition() {
  arr1=($1)
  arr2=($2)
  
  result_arr=()
  
  local arr1_size=${#arr1[@]}
  local arr2_size=${#arr2[@]}
  local arr1_idx=0
  local arr2_idx=0
  
  local cur_item=0
  local last_item=0
  
  while (( arr1_idx < arr1_size || arr2_idx < arr2_size )); do
    if (( arr1_idx == arr1_size )); then
      cur_item=${arr2[${arr2_idx}]}
      ((arr2_idx++))
    elif (( arr2_idx == arr2_size )); then
      cur_item=${arr1[${arr1_idx}]}
      ((arr1_idx++))
    else
      if (( arr1[arr1_idx] < arr2[arr2_idx] )); then
        cur_item=${arr1[${arr1_idx}]}
      ((arr1_idx++))
      elif (( arr1[arr1_idx] == arr2[arr2_idx] )); then
        cur_item=${arr1[${arr1_idx}]}
      ((arr1_idx++))
      ((arr2_idx++))
      else
        cur_item=${arr2[${arr2_idx}]}
      ((arr2_idx++))
      fi
    fi
    
    if (( cur_item != last_item )); then
      result_arr+=(${cur_item})
      last_item=${cur_item}
    fi
  done
  
  echo "${result_arr[@]}"
}

