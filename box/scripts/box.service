# DONE: (priority: mid)
# get and set ${sys_rule_index} from system ip rule result
start_service() {
  if check_permission ; then
    log Info "${bin_name} will be started with the ${box_user_group} user group."
    
    # find and record the tun ip rule starting index
    local rule_idx="$(ip rule show | head -n 1 | awk -F: '{print $1}')"
    if [[ "${rule_idx}" != "" && "${rule_idx}" != "0" ]]; then
      sys_rule_index="${rule_idx}"
      sed -i "s/^sys_rule_index=.*/sys_rule_index=\"${sys_rule_index}\"/" ${scripts_dir}/box.config
    fi
    
    if start_bin && wait_bin_listen ; then
      log Info "${bin_name} service is running. ( PID: $(cat ${pid_file}) )"
      return 0
    else
      check_stored_pid_running
      if [ $? -eq 0 ] ; then
        log Warn "${bin_name} service is running but may not listening. ( PID: ${bin_pid} )"
        return 0
      else
        log Error "start ${bin_name} service failed, please check the ${run_path}/error_${bin_name}.log file."
        rm -f ${pid_file} >> /dev/null 2>&1
        return 1
      fi
    fi
  else
    log Error "missing ${bin_name} core, please download and place it in the ${box_path}/bin/ directory"
    return 2
  fi
}

stop_service() {
  if display_bin_status ; then
    log Warn "stopping ${bin_name} service."
    kill $(cat ${pid_file})
    sleep 1
    display_bin_status
  else
    # when cannot find $(cat ${pid_file}) as a running ${bin_name} process, attempt to killall running ${bin_name} process
    killall ${bin_name}
  fi
  rm -f ${pid_file} >> /dev/null 2>&1
}


