#!/system/bin/sh


events=$1
# monitor_dir=$2
# monitor_file=$3

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH:/data/data/com.termux/files/usr/bin"

scripts=$(realpath $0)
scripts_dir=$(dirname ${scripts})
module_dir="/data/adb/modules/box4"

if ! [ "${events}" = w ]; then
	return
fi

source ${scripts_dir}/box.config
source ${scripts_dir}/rules.utils


export TZ=Asia/Shanghai

if [ -f "${module_dir}/disable" ]; then
  exit
fi

# DONE: (priority: mid)
# auto ipv6
# when switch network, switch ipv6 on/off based on ipv6 connectivity
if [[ "${ipv6_mode}" == "auto" ]]; then
  auto_ipv6
fi

# DONE: (priority: mid)
# auto gcm/fcm
# when switching network, switch proxy on/off for google gcm/fcm service based on non-proxy fcm connectivity
# TODO: (priority: low)
# if fcm is un-accessible:
#   use iptables to hijack dns request to mtalk[0-9].google.com, return a proxy ip address
if [[ "${fcm_proxy}" == "auto" ]]; then
  auto_fcm
fi

# DONE: (priority: mid)
# auto switch proxy on/off based on wifi ssid
# if connected to a known wifi ssid, turn off/pause proxy
if [[ "${bypass_wifi}" == "true" ]]; then
  new_network_type=$(get_network_type)
  new_wifi_ssid=$(get_wifi_ssid)

  if [[ "$(get_network_type)" == "wifi" && "${new_wifi_ssid}" != "" && " ${wifi_ssid_list[@]} " == *" ${new_wifi_ssid} "* ]]; then
    ${scripts_dir}/box.service pause
  else
    # TODO: (priority: high)
    # checks if should be paused by other conditions
    ${scripts_dir}/box.service resume
  fi
fi